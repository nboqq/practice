# Environment variables example
# Copy this file to .env and update with your actual values

# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/flower-shop
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/flower-shop
MONGODB_URI=mongodb://localhost:27017/flower-shop

# JWT secret key for token signing (change this in production!)
JWT_SECRET=your_super_secret_key_change_in_production

# Server port
PORT=5000

# Environment
NODE_ENV=development
